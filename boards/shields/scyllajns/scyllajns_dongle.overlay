#include "scyllajns.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
        
        /* ESTA LINHA FALTAVA: Vincula o ZMK Studio ao layout do seu DTSI */
        zmk,physical-layout = &physical_layout0;
    };

    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* Desativa o kscan físico no dongle */
&kscan0 {
    status = "disabled";
};

&pro_micro_i2c {
    status = "okay";

    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
        inversion-on;
        segment-remap;
        com-invdir;
    };
};