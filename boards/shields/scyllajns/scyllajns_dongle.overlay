#include "scyllajns.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &scyllajns_layout;
        /* O zmk,matrix-transform já é herdado de scyllajns.dtsi */
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* Vincula o layout ao kscan mock */
&scyllajns_layout {
    kscan = <&mock_kscan>;
};

/* Desativa o kscan real */
&kscan0 {
    status = "disabled";
};

/* Mantém o seu display I2C */
&pro_micro_i2c {
    status = "okay";
    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
        inversion-on;
        segment-remap;
        com-invdir;
    };
};